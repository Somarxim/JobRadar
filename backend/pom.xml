<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父 POM：获得依赖版本仲裁（dependencyManagement）与插件默认配置，
         子模块中绝大部分依赖无需写版本号 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.jobradar</groupId>
    <artifactId>jobradar-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>jobradar-backend</name>
    <description>JobRadar - AI-powered job hunting cockpit (backend)</description>

    <!-- 多模块划分：core 沉淀全部领域逻辑，app(HTTP) 与 mcp-server(stdio) 是同一能力的两种宿主。
         见 docs/architecture.md §2 与 ADR-5 -->
    <modules>
        <module>jobradar-core</module>
        <module>jobradar-app</module>
        <module>jobradar-mcp-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring AI 独立版本列车（不随 Boot 父 POM 管理），通过 BOM 导入 -->
        <spring-ai.version>1.0.0</spring-ai.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <!-- Jsoup：W3 爬虫抓取与 HTML 解析（Boot 父 POM 不管理，需显式锁版本） -->
        <jsoup.version>1.18.3</jsoup.version>
        <!-- Testcontainers 覆盖为新版：Boot 3.5 管理的 1.21.0 内置 docker-java 用老 API 版本
             访问 Docker 29 daemon 被 400 拒绝（实测），1.21.3 修复了版本协商 -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全模块公共：测试基线。scope=test 不进入产物 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
