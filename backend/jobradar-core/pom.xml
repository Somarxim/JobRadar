<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jobradar</groupId>
        <artifactId>jobradar-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- 核心模块：domain(JPA Entity) / repository / service / agent / crawler。
         不依赖 web 环境，保证可被 app 与 mcp-server 两种宿主复用（ADR-5） -->
    <artifactId>jobradar-core</artifactId>
    <name>jobradar-core</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway：schema 版本化迁移。脚本位于 app 模块 resources/db/migration，
             core 只声明依赖以便实体校验（ddl-auto=validate） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- jackson-annotations：领域枚举的 @JsonValue（JSON 输出小写，匹配 API 契约）。
             只引 annotations 不引 databind——序列化实现由 app 模块的 spring-boot-starter-web 提供 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Lombok：编译期生成 getter/setter，消除实体样板代码。optional=true 不向下游传递
             （下游模块拿到的是编译好的 class，无需 Lombok）。刻意只用 @Getter/@Setter 不用 @Data，
             原因见 Company 类注释。面试点：Lombok 是编译期注解处理（改 AST），
             Spring 是运行期代理，二者完全不同层面。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI OpenAI 模型端：DeepSeek/DashScope 均兼容 OpenAI 协议，
             一个 starter 换 base-url 即可路由多家模型（W2）。
             注意：不走 spring.ai.* 自动装配——多模型实例由 app 层 LlmConfig 显式构造，
             未配置 key 时降级而非启动失败。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- PDFBox：简历 PDF 文本提取（本地解析，零成本；扫描件无文字层时返回空文本，
             由上层提示走海报式多模态/人工路线） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
            <exclusions>
                <!-- PDFBox 传入了真正的 commons-logging jar，与 spring-jcl 同包名冲突，
                     且其发现逻辑会向 stdout 打印警告——MCP stdio 模式下这会污染协议流。
                     排除后 spring-jcl 作为同包名 drop-in 接管，PDFBox 日志照常走 SLF4J -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Jsoup：W3 爬虫管线。选 Jsoup 而非裸 Java HTTP Client 的理由：抓取 + CSS
             选择器解析一体，静态页一个依赖全覆盖；遇 JS 渲染页（SPA）按站点适配时
             优先找其 JSON API，再考虑 Playwright（roadmap 风险登记：源插件化） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!-- snakeyaml：公司别名映射表 company-aliases.yml 加载（W3 去重归一化）。
             spring-boot-starter 系已传递引入，此处显式声明表示 core 直接使用 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- jieba-analysis：中文分词。jobs.search_vector 是 to_tsvector('simple', search_text)
             生成列——'simple' 配置不做中文分词，所以应用层先用 jieba 把文本切成空格分隔的
             词元写入 search_text，检索时查询词同样切词后拼 tsquery（JiebaSearchText）。
             选 jieba 而非 IK/ANSJ：纯 Java 无 native 依赖、词典内置、API 两行上手 -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>${jieba.version}</version>
        </dependency>
    </dependencies>
</project>
