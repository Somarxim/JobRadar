<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jobradar</groupId>
        <artifactId>jobradar-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- 核心模块：domain(JPA Entity) / repository / service / agent / crawler。
         不依赖 web 环境，保证可被 app 与 mcp-server 两种宿主复用（ADR-5） -->
    <artifactId>jobradar-core</artifactId>
    <name>jobradar-core</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway：schema 版本化迁移。脚本位于 app 模块 resources/db/migration，
             core 只声明依赖以便实体校验（ddl-auto=validate） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- jackson-annotations：领域枚举的 @JsonValue（JSON 输出小写，匹配 API 契约）。
             只引 annotations 不引 databind——序列化实现由 app 模块的 spring-boot-starter-web 提供 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Lombok：编译期生成 getter/setter，消除实体样板代码。optional=true 不向下游传递
             （下游模块拿到的是编译好的 class，无需 Lombok）。刻意只用 @Getter/@Setter 不用 @Data，
             原因见 Company 类注释。面试点：Lombok 是编译期注解处理（改 AST），
             Spring 是运行期代理，二者完全不同层面。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI OpenAI 模型端：DeepSeek/DashScope 均兼容 OpenAI 协议，
             一个 starter 换 base-url 即可路由多家模型（W2）。
             注意：不走 spring.ai.* 自动装配——多模型实例由 app 层 LlmConfig 显式构造，
             未配置 key 时降级而非启动失败。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
    </dependencies>
</project>
