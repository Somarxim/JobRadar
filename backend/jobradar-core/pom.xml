<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jobradar</groupId>
        <artifactId>jobradar-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- 核心模块：domain(JPA Entity) / repository / service / agent / crawler。
         不依赖 web 环境，保证可被 app 与 mcp-server 两种宿主复用（ADR-5） -->
    <artifactId>jobradar-core</artifactId>
    <name>jobradar-core</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway：schema 版本化迁移。脚本位于 app 模块 resources/db/migration，
             core 只声明依赖以便实体校验（ddl-auto=validate） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring AI 的 chat/embedding starter 在 W2 接入匹配 Agent 时引入；
             过早引入会导致未配置 API Key 时应用启动失败 -->
    </dependencies>
</project>
